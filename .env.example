# Copy to .env, fill in real values. Never commit the real file (gitignored).

# Where this service's own SQLite file lives. Seeded at cutover from Metron's original
# auth.sqlite (see docs/CUTOVER.md) so existing accounts carry over.
AUTH_DATABASE_URL=./auth.sqlite

# This service's own public URL — used as the JWT issuer and better-auth's baseURL.
AUTH_BASE_URL=https://auth.nousergon.ai

# Comma-separated, no spaces. Every hostname allowed to call this service AND have its
# session cookie/CORS response accepted (metron.nousergon.ai serves the app at /dash;
# vires.nousergon.ai at /app — origins are host-scoped, so no path here).
# SSM-hydrated at deploy from /nousergon-auth/auth_trusted_origins (plain String param,
# not a secret) — see infrastructure/deploy-on-merge.sh. That parameter is the durable
# source of truth in prod; this .env value is only what local dev actually uses.
# (portfolio.nousergon.ai removed 2026-07-22 — hostname deprecated, metron-ops#225.)
AUTH_TRUSTED_ORIGINS=https://metron.nousergon.ai,https://vires.nousergon.ai

# Cross-subdomain session cookie domain — must be a parent of every trusted origin above.
AUTH_COOKIE_DOMAIN=.nousergon.ai

# better-auth's own session/token signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Resend (transactional email for magic links) — same account Metron already uses.
RESEND_API_KEY=
EMAIL_SENDER=no-reply@nousergon.ai

# Set to "false" only for local/dev convenience. Defaults closed (gate ON) — see
# src/allowlist-gate.ts. Responses are UNIFORM: an unapproved address gets the same
# success response as an approved one (no email is sent); rejections appear only in
# the server log.
ALLOWLIST_GATE_ENABLED=true

PORT=4100
