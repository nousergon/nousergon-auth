[Unit]
Description=nousergon-auth — shared identity service (Better Auth)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/nousergon-auth
EnvironmentFile=/home/ec2-user/nousergon-auth/.env
# node-24 explicitly, NOT the box-default /usr/bin/node (still 18/EOL until
# alpha-engine-config-I6094): jose's key generation needs global WebCrypto (Node >= 19)
# — /jwks 500s under Node 18 — and package.json engines.node declares >=24.15.0
# (alpha-engine-config-I12116). nodejs24 is installed side-by-side by
# deploy-on-merge.sh; the default alternative is left untouched so other services are
# unaffected. The major here must equal NODE_MAJOR in deploy-on-merge.sh.
ExecStart=/usr/bin/node-24 dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
