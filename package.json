{
  "name": "nousergon-auth",
  "version": "0.0.1",
  "private": true,
  "description": "Shared, self-hosted identity service (Better Auth) for Nous Ergon products — magic-link auth + JWT/JWKS verification, used by Metron and Vires. Owns identity only; each product keeps its own tenant/workspace concept.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "better-auth migrate --config src/auth.ts -y"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "better-sqlite3": "^12.10.0",
    "resend": "^5.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.5.0-beta.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "prisma": "5.22.0",
    "drizzle-orm": "^0.45.2",
    "lodash": "4.18.1"
  }
}
